# Database (Optional — runs instant seeded DemoStore when omitted; supports legacy DATABASE_URL / MONGO_URI)
MONGODB_URI=
# DATABASE_URL=
MONGODB_DB=hann_studio

# Auth JWT (Optional in local/demo mode; set a strong secret in production with MongoDB)
JWT_SECRET=replace-with-strong-secret-in-production
# ALLOW_DEMO_AUTH=true

# AWS S3 Media Upload (Optional — supports AWS_S3_BUCKET or legacy AWS_S3_BUCKET_NAME; falls back to WebP demo when omitted)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# AWS_S3_BUCKET_NAME=
AWS_S3_PUBLIC_BASE_URL=
