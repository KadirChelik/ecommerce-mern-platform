# Database (Optional — runs instant seeded DemoStore when omitted)
MONGODB_URI=
MONGODB_DB=hann_studio

# Auth JWT (Optional — uses safe ephemeral/demo secret in local & demo mode)
JWT_SECRET=replace-with-strong-secret-in-production

# AWS S3 Media Upload (Optional — falls back to client-side demo WebP upload when omitted)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=
